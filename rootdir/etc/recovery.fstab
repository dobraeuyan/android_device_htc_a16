# Android fstab file.

#<src>					<mnt_point>	<type>	<mnt_flags and options>			<fs_mgr_flags>
/dev/block/bootdevice/by-name/system	/system		ext4	ro,barrier=1,nodiratime			wait
/dev/block/bootdevice/by-name/userdata	/data		f2fs	noatime,nosuid,nodev,rw,inline_xattr	wait,check,formattable,encryptable=/dev/block/bootdevice/by-name/extra
/dev/block/bootdevice/by-name/cache	/cache		f2fs	noatime,nosuid,nodev,rw,inline_xattr	wait,check,formattable

/dev/block/bootdevice/by-name/frp	/persistent	emmc	defaults				defaults
/dev/block/bootdevice/by-name/boot	/boot		emmc	defaults				defaults
/dev/block/bootdevice/by-name/recovery	/recovery	emmc	defaults				defaults

/devices/soc.0/7864900.sdhci/mmc_host*	auto		auto	nosuid,nodev				voldmanaged=sdcard1:auto,noemulatedsd,encryptable=footer
/devices/platform/msm_hsusb*		auto		auto	nosuid,nodev				voldmanaged=usbotg:auto
